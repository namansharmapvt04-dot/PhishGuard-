# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/phishguard

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ────────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── LLMs ───────────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
OPENAI_API_KEY=sk-...          # Optional fallback

# ── LangGraph / Agent config ───────────────────────────────────────────────────
PRIMARY_MODEL=llama-3-70b-8192   # Groq model
FALLBACK_MODEL=gpt-4o            # OpenAI fallback
RAGAS_PASS_THRESHOLD=0.75
MAX_RETRIES=3

# ── ChromaDB ───────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=phishing_patterns
RAG_TOP_K=5

# ── Tracking ───────────────────────────────────────────────────────────────────
BASE_URL=http://localhost:8000      # Public URL for tracking links
TRACKING_WINDOW_DAYS=14

# ── App ────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO
