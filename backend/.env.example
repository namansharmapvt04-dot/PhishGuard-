# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/phishguard

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ────────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── LLMs ───────────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
OPENAI_API_KEY=sk-...          # Optional fallback

# ── LangGraph / Agent config ───────────────────────────────────────────────────
PRIMARY_MODEL=llama-3-70b-8192   # Groq model
FALLBACK_MODEL=gpt-4o            # OpenAI fallback
RAGAS_PASS_THRESHOLD=0.75
MAX_RETRIES=2

# ── ChromaDB ───────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=phishing_patterns
RAG_TOP_K=5

# ── Tracking ───────────────────────────────────────────────────────────────────
BASE_URL=http://localhost:8000      # Public URL for tracking links
TRACKING_WINDOW_DAYS=14

# ── App ────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
# Comma-separated if you need more than one (e.g. your Vercel prod domain +
# a preview deployment URL) — this is a CORS allow-list, not a single value.
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO

# ── Production deploy notes (see render.yaml) ───────────────────────────────────
# DATABASE_URL — use a Neon (neon.tech) Postgres connection string in prod;
#   Render's own free Postgres wipes its data after 30 days. Use Neon's
#   UNPOOLED connection string (this app keeps its own SQLAlchemy pool —
#   layering Neon's PgBouncer pooler under asyncpg's prepared statements
#   causes "prepared statement does not exist" errors), rewrite the scheme
#   to postgresql+asyncpg://, and replace sslmode=require&channel_binding=require
#   with just ?ssl=require (asyncpg's URL parser doesn't understand the
#   libpq-style params Neon's dashboard gives you by default). e.g.:
#   postgresql+asyncpg://user:pass@ep-xxx.region.aws.neon.tech/neondb?ssl=require
# REDIS_URL    — Render's free Key Value service works fine; refresh tokens
#   and quota counters are short-TTL and fine to lose on a restart.
# BASE_URL     — must be the backend's own public HTTPS URL once deployed
#   (embedded in tracking links/pixels and uploaded-image URLs).
