# Dev server proxies /api and /track to this target.
# Local dev: http://localhost:8000
# docker-compose: http://backend:8000
VITE_PROXY_TARGET=http://localhost:8000

# Production only (set in Vercel's project env vars, not used in dev —
# the Vite proxy above handles local requests instead). Must be the
# deployed backend's origin, no trailing slash, e.g.:
# VITE_API_BASE_URL=https://phishguard-api.onrender.com
VITE_API_BASE_URL=
